DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MOKA_BASE_URL=https://api.mokahr.com
MOKA_API_KEY=
MOKA_ENTERPRISE_ID=
MOKA_AUTH_MODE=basic
MOKA_API_KEY_HEADER=Authorization
MOKA_API_KEY_PREFIX=
MOKA_TIMEOUT_MS=8000
# 仅在成员用户名还不是邮箱时兜底；用户名是邮箱时以用户名为准
MOKA_OPERATOR_EMAIL=
MOKA_PROJECT_NAME=QS
TRANSCRIPTION_PROVIDER=baidu
WORKER_INTERVAL_MS=15000
# Baidu long-audio provider
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# Whisper / FunASR provider endpoints are server-side only
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# 自建 faster-whisper 网关（workers/faster-whisper-service）时：
#   TRANSCRIPTION_PROVIDER=whisper
#   WHISPER_API_URL=http://<asr-host>:9001/v1/audio/transcriptions
# 默认走 audio_url 让网关自行下载，绕开 Cloud Run 32MB 请求体上限；
# 设为 file 则强制 multipart 上传（仅适合短录音）。
WHISPER_UPLOAD_MODE=auto
WHISPER_LANGUAGE=zh
WHISPER_TIMEOUT_MS=2700000
# 券商术语表，注入 Whisper initial_prompt，显著降低「CCASS/清结算/场外期权」等同音误写
ACECALL_ASR_HOTWORDS=
# 超过该时长的录音自动切段后再转写（CloudBase uploadFile 只接受 Buffer，必须控制单文件体积）
TRANSCRIPTION_AUTO_SEGMENT_SECONDS=900
# 显式指定切段长度；留空或 0 表示按上面的自动阈值判断
TRANSCRIPTION_SEGMENT_SECONDS=
FUNASR_API_URL=
FUNASR_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
PORT=4173
HOST=127.0.0.1
